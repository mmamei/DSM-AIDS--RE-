   "source": [
    "import numpy as np\n",
    "from scipy.stats import norm\n",
    "\n",
    "r = 0.40\n",
    "rho_0 = 0\n",
    "n = 30\n",
    "\n",
    "z = (\n",
    "    np.arctanh(r) - np.arctanh(rho_0)\n",
    ") * np.sqrt(n - 3)\n",
    "\n",
    "p_value = 1 - norm.cdf(z)\n",
    "\n",
    "print(f\"z = {z:.3f}\")\n",
    "print(f\"p-value = {p_value:.4f}\")"
   ]
  }
 ],
